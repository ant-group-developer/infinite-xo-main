{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'avatar', 'country', 'createdAt', 'linked'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
        },
        "avatar": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 32"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
        },
        "createdAt": {
          ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()"
        },
        "linked": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": "auth != null",
      ".indexOn": [
        "rating"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['rating', 'games', 'w', 'l', 'd', 'streak', 'bestStreak', 'peak', 'season', 'name', 'avatar', 'country'])",
        "rating": {
          ".validate": "(!data.exists() && newData.val() === 1000) || newData.val() === data.val()"
        },
        "games": {
          ".validate": "(!data.exists() && newData.val() === 0) || newData.val() === data.val()"
        },
        "w": {
          ".validate": "(!data.exists() && newData.val() === 0) || newData.val() === data.val()"
        },
        "l": {
          ".validate": "(!data.exists() && newData.val() === 0) || newData.val() === data.val()"
        },
        "d": {
          ".validate": "(!data.exists() && newData.val() === 0) || newData.val() === data.val()"
        },
        "streak": {
          ".validate": "(!data.exists() && newData.val() === 0) || newData.val() === data.val()"
        },
        "bestStreak": {
          ".validate": "(!data.exists() && newData.val() === 0) || newData.val() === data.val()"
        },
        "peak": {
          ".validate": "(!data.exists() && newData.val() === 1000) || newData.val() === data.val()"
        },
        "season": {
          ".validate": "(!data.exists() && newData.val() === 1) || newData.val() === data.val()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
        },
        "avatar": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 32"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'lastSeen'])",
        "state": {
          ".validate": "newData.val() === 'online' || newData.val() === 'offline'"
        },
        "lastSeen": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$rid": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && (data.child('meta/hostUid').val() === auth.uid || data.child('meta/lastActive').val() < now - 1800000)",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['hostUid', 'name', 'visibility', 'code', 'type', 'createdAt', 'lastActive', 'status'])",
          "hostUid": {
            ".write": "auth != null && newData.val() === auth.uid && newData.parent().parent().child('members/' + auth.uid).exists() && !newData.parent().parent().child('members/' + data.val()).exists()",
            ".validate": "newData.isString() && newData.parent().parent().child('members/' + newData.val()).exists()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "visibility": {
            ".validate": "newData.val() === 'public' || newData.val() === 'private'"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6}$/) && (!data.exists() || newData.val() === data.val())"
          },
          "type": {
            ".validate": "(newData.val() === 'casual' || newData.val() === 'ranked' || newData.val() === 'bot') && (!data.exists() || newData.val() === data.val())"
          },
          "createdAt": {
            ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()"
          },
          "lastActive": {
            ".validate": "newData.val() === now"
          },
          "status": {
            ".validate": "newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished'"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (($uid === auth.uid && !root.child('rooms/' + $rid + '/kicked/' + auth.uid).exists()) || (!newData.exists() && root.child('rooms/' + $rid + '/meta/hostUid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'avatar', 'country', 'rating', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
            },
            "avatar": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 32"
            },
            "country": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
            },
            "rating": {
              ".validate": "newData.isNumber() && newData.val() === root.child('stats/' + $uid + '/rating').val()"
            },
            "joinedAt": {
              ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "kicked": {
          "$uid": {
            ".write": "auth != null && root.child('rooms/' + $rid + '/meta/hostUid').val() === auth.uid && $uid !== auth.uid",
            ".validate": "newData.val() === true"
          }
        },
        "slots": {
          "$side": {
            ".write": "auth != null && root.child('rooms/' + $rid + '/meta/status').val() !== 'playing' && ((newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && newData.parent().parent().child('members/' + auth.uid).exists()) || (!newData.exists() && (data.val() === auth.uid || root.child('rooms/' + $rid + '/meta/hostUid').val() === auth.uid)))",
            ".validate": "($side === 'X' || $side === 'O') && newData.isString()"
          }
        },
        "ready": {
          "$side": {
            ".write": "auth != null && (newData.parent().parent().child('slots/' + $side).val() === auth.uid || (!newData.exists() && (root.child('rooms/' + $rid + '/meta/hostUid').val() === auth.uid || root.child('rooms/' + $rid + '/slots/' + $side).val() === auth.uid)))",
            ".validate": "($side === 'X' || $side === 'O') && newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? newData.isString() : (!newData.exists() && (root.child('rooms/' + data.val() + '/meta/hostUid').val() === auth.uid || !root.child('rooms/' + data.val() + '/meta').exists() || root.child('rooms/' + data.val() + '/meta/lastActive').val() < now - 1800000)))",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/) && newData.isString()"
      }
    },
    "roomIndex": {
      ".read": "auth != null",
      ".indexOn": [
        "lastActive"
      ],
      "$rid": {
        ".write": "auth != null && (newData.exists() ? newData.parent().parent().child('rooms/' + $rid + '/meta/hostUid').val() === auth.uid : (root.child('rooms/' + $rid + '/meta/hostUid').val() === auth.uid || !root.child('rooms/' + $rid + '/meta').exists() || data.child('lastActive').val() < now - 1800000))",
        ".validate": "newData.hasChildren(['name', 'hostName', 'players', 'spectators', 'status', 'lastActive'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "hostName": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "players": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
        },
        "spectators": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32"
        },
        "status": {
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished'"
        },
        "lastActive": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomChat": {
      "$rid": {
        ".read": "auth != null && root.child('rooms/' + $rid + '/members/' + auth.uid).exists()",
        ".write": "auth != null && !newData.exists() && (root.child('rooms/' + $rid + '/meta/hostUid').val() === auth.uid || !root.child('rooms/' + $rid + '/meta').exists() || root.child('rooms/' + $rid + '/meta/lastActive').val() < now - 1800000)",
        "$mid": {
          ".write": "auth != null && !data.exists() && root.child('rooms/' + $rid + '/members/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 't'])",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
