{
  "name": "infinite-xo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node -e \"process.env.BENCH=1;require('child_process').execSync('npx vitest run',{stdio:'inherit',env:process.env})\"",
    "rules:build": "node scripts/gen-games-rules.cjs database.rules.json && node scripts/gen-rating-rules.cjs database.rules.json && node scripts/gen-mm-rules.cjs database.rules.json",
    "rules:deploy": "npx firebase-tools deploy --only database",
    "rules:smoke": "node scripts/rules-smoke.mjs",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting,database",
    "docker:up": "docker compose --env-file .env.local up -d --build",
    "docker:down": "docker compose --env-file .env.local down",
    "docker:logs": "docker compose --env-file .env.local logs -f"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "three": "^0.187.0"
  }
}
