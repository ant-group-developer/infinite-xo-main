# Copy to .env (Docker / docker compose) or .env.local (npm run dev).
# Everything here is PUBLIC: it ends up in the browser. Security comes from
# database.rules.json, not from hiding these values.

# ---------------------------------------------------------------- container
# Port nginx listens on inside the container.
PORT=8080
# Port published on the host by docker compose.
HOST_PORT=8080
# Which sites may embed the game in an <iframe> (CSP frame-ancestors):
#   *                                              any site
#   'self' https://example.com https://*.example.com   only these
#   'none'                                         not embeddable
FRAME_ANCESTORS=*

# --------------------------------------------------------------- app (runtime)
# false = hide Online / Profile (pure offline game).
VITE_ONLINE_ENABLED=true
# Base URL used in room invite links (default: the game's own URL).
# Set it to the page that embeds the game if invites should land there;
# that page must then pass ?room=CODE to the iframe (see docs/DEPLOY.md).
VITE_PUBLIC_URL=

# Firebase console → Project settings → Your apps → Config.
# Leave API key / database URL empty to use the in-browser local backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
